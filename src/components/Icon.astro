---
import { siGithub, siX, siProducthunt, siBuymeacoffee, siPypi } from 'simple-icons';
import mail from 'lucide-static/icons/mail.svg?raw';
import arrowRight from 'lucide-static/icons/arrow-right.svg?raw';
import arrowUpRight from 'lucide-static/icons/arrow-up-right.svg?raw';
import arrowDown from 'lucide-static/icons/arrow-down.svg?raw';
import download from 'lucide-static/icons/download.svg?raw';
import copy from 'lucide-static/icons/copy.svg?raw';
import check from 'lucide-static/icons/check.svg?raw';

const brand: Record<string, string> = {
  github: siGithub.svg,
  x: siX.svg,
  producthunt: siProducthunt.svg,
  buymeacoffee: siBuymeacoffee.svg,
  pypi: siPypi.svg,
};
const ui: Record<string, string> = {
  mail, 'arrow-right': arrowRight, 'arrow-up-right': arrowUpRight,
  'arrow-down': arrowDown, download, copy, check,
};

interface Props { name: string; size?: number; class?: string }
const { name, size = 18, class: cls = '' } = Astro.props;
const isBrand = name in brand;
const svg = isBrand ? brand[name] : ui[name];
if (!svg) throw new Error(`Unknown icon: ${name}`);
---

<span class:list={['icon', !isBrand && 'icon-ui', cls]} style={`width:${size}px;height:${size}px`} aria-hidden="true" set:html={svg} />
