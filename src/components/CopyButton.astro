---
import Icon from './Icon.astro';

interface Props { text?: string; emailParts?: { user: string; domain: string }; label?: string; class?: string }
const { text, emailParts, label, class: cls = '' } = Astro.props;
---

<button type="button" class:list={['copy-btn', cls]} data-copy={text} data-email-copy={emailParts ? '' : undefined} data-email-user={emailParts?.user} data-email-domain={emailParts?.domain} aria-label={label ? `Copy ${label}` : 'Copy'}>
  <Icon name="copy" size={16} class="icon-copy" />
  <Icon name="check" size={16} class="icon-check" />
  {label && <span data-copy-label>{label}</span>}
</button>
