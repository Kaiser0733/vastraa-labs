---
import SiteLayout from '../layouts/SiteLayout.astro';
import RuledRow from '../components/RuledRow.astro';
import Icon from '../components/Icon.astro';
import { people } from '../data/studio';
import { shipLog } from '../data/ship-log';

const how = [
  'Products appear on this site only after they are released.',
  'We maintain what we release. Fixes and updates keep shipping after launch.',
  'Rivet and Governer are open source. Freeline is free to use.',
];
---

<SiteLayout title="Studio — Vastraa Labs" description="The people behind Vastraa Labs products, and the record of releases.">
  <section style="padding-top:48px">
    <span class="mono-label">STUDIO</span>
    <h1 style="margin-top:16px">Who we are.</h1>
    <p style="margin-top:24px">Vastraa Labs is an AI studio run by two people. We build our own products and release them in public. Everything listed on this site is available to use today.</p>
  </section>

  <section aria-label="How we work">
    {how.map((line, i) => (
      <div class="fact-row">
        <span class="mono muted">0{i + 1}</span>
        <span style="flex:1;color:var(--porcelain);font-size:1.25rem;font-weight:500">{line}</span>
      </div>
    ))}
  </section>

  <section aria-label="People">
    <div class="ruled">
      {people.map((p) => (
        <RuledRow>
          <span class="row-main">
            <span class="row-name">{p.name ?? p.role}</span>
            {p.handle && <span class="mono muted" style="margin-left:16px">{p.handle}</span>}
          </span>
          {p.name && <span>{p.role}</span>}
          {p.x && <a href={p.x} aria-label={`${p.name} on X`}><Icon name="x" /></a>}
          {p.github && <a href={p.github} aria-label={`${p.name} on GitHub`}><Icon name="github" /></a>}
          {p.instagram && <a href={p.instagram} aria-label={`${p.name} on Instagram`}><Icon name="instagram" /></a>}
        </RuledRow>
      ))}
    </div>
  </section>

  <section aria-label="Ship ledger">
    <p class="mono-label" data-line>SHIP LEDGER</p>
    <div style="margin-top:16px">
      {shipLog.map((e) => (
        <div class="ledger-row">
          <span class="mono muted" style="min-width:96px">{e.date}</span>
          <span style="color:var(--porcelain)">{e.line}</span>
        </div>
      ))}
    </div>
  </section>
</SiteLayout>
