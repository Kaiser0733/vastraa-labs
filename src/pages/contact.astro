---
import SiteLayout from '../layouts/SiteLayout.astro';
import RuledRow from '../components/RuledRow.astro';
import CopyButton from '../components/CopyButton.astro';
import Icon from '../components/Icon.astro';
import BlendedMascot from '../components/BlendedMascot.astro';
import { links } from '../data/links';

// The only Buy Me a Coffee URL on the site. It lives here alone.
const buyMeACoffee = 'https://buymeacoffee.com/Vastraalabs';

const rows = [
  { icon: 'github', label: 'GitHub', handle: 'Kaiser0733', href: links.github },
  { icon: 'x', label: 'X', handle: '@Not_Kaiser', href: links.x },
  { icon: 'producthunt', label: 'Product Hunt', handle: 'Rivet', href: links.productHunt },
];
---

<SiteLayout title="Contact — Vastraa Labs" description="Write to Vastraa Labs: work, grants, bugs, press.">
  <section style="padding-top:48px">
    <h1>Write to us.</h1>
    <p class="mono muted" style="margin-top:16px">Work, grants, bugs, press.</p>

    <div class="ruled" style="margin-top:48px">
      <RuledRow>
        <Icon name="mail" />
        <span class="row-main mono" style="color:var(--porcelain);font-size:1rem" data-email-text data-email-user={links.emailUser} data-email-domain={links.emailDomain}>contact (at) vastraalabs.online</span>
        <CopyButton emailParts={{ user: links.emailUser, domain: links.emailDomain }} label="Copy" />
        <a class="text-link" data-email-user={links.emailUser} data-email-domain={links.emailDomain} style="display:inline-flex;gap:8px;align-items:center;cursor:pointer">Open <Icon name="arrow-up-right" size={16} /></a>
      </RuledRow>
      {rows.map((r) => (
        <RuledRow href={r.href}>
          <Icon name={r.icon} />
          <span class="row-main" style="color:var(--porcelain)">{r.handle}</span>
          <span class="mono-label" style="margin-right:8px">{r.label}</span>
          <span class="row-arrow"><Icon name="arrow-up-right" size={16} /></span>
        </RuledRow>
      ))}
    </div>
  </section>

  <div class="rest" aria-hidden="true"></div>

  <section id="support" class="support" style="margin-top:0">
    <div class="support-text">
      <h2>Support Vastraa Labs.</h2>
      <p class="line">Support goes toward developing and maintaining our products.</p>
      <a class="btn" href={buyMeACoffee}><Icon name="buymeacoffee" /> Buy Me a Coffee</a>
    </div>
    <BlendedMascot />
  </section>
</SiteLayout>
